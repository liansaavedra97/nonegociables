{
  "id": "./",
  "name": "NO NEGOCIABLES",
  "short_name": "No negociables",
  "description": "Registro diario de tus no negociables. Funciona sin conexión y guarda los datos solo en tu dispositivo.",
  "lang": "es",
  "dir": "ltr",
  "start_url": "./#today",
  "scope": "./",
  "display": "standalone",
  "display_override": ["standalone", "minimal-ui"],
  "orientation": "portrait",
  "background_color": "#14181F",
  "theme_color": "#14181F",
  "categories": ["productivity", "lifestyle", "health"],
  "icons": [
    { "src": "icons/icon-192.png", "sizes": "192x192", "type": "image/png", "purpose": "any" },
    { "src": "icons/icon-512.png", "sizes": "512x512", "type": "image/png", "purpose": "any" },
    { "src": "icons/maskable-512.png", "sizes": "512x512", "type": "image/png", "purpose": "maskable" },
    { "src": "icons/icon.svg", "sizes": "any", "type": "image/svg+xml", "purpose": "any" }
  ],
  "shortcuts": [
    { "name": "Hoy", "url": "./#today", "icons": [{ "src": "icons/icon-192.png", "sizes": "192x192" }] },
    { "name": "Historial", "url": "./#history", "icons": [{ "src": "icons/icon-192.png", "sizes": "192x192" }] }
  ]
}
